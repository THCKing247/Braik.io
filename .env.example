# Copy to ".env.local" for local Next.js (never commit .env or .env*.local).
# Production: set the same keys in your host (e.g. Netlify) environment UI.

# --- Supabase (required for `npm run build` in production / CI) ---
# Project Settings → API: Project URL + anon (publishable) key + service_role (server only).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session signing (recommended in production)
# AUTH_SECRET=

# --- Head coach fetch budget verification (optional local) ---
# Build + start with monitor enabled, then: npm run verify:coach-fetches
# NEXT_PUBLIC_DEBUG_FETCHES=1
# BASE_URL=http://localhost:3000
# COACH_EMAIL=
# COACH_PASSWORD=
# SHORT_ORG_ID=1
# SHORT_TEAM_ID=1

# --- Postmark (server-side transactional email) ---
# Server API token from Postmark → Server → API Tokens
POSTMARK_SERVER_TOKEN=
# Optional — overrides default From (Braik <noreply@apextsgroup.com>); must be verified in Postmark
POSTMARK_FROM_EMAIL=
# Optional
# POSTMARK_REPLY_TO_EMAIL=
# POSTMARK_SUPPORT_EMAIL=
POSTMARK_MESSAGE_STREAM=outbound
